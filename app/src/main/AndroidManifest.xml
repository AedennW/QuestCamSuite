<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ────────────────────────────────────────────────────────────────
         Quest 3 passthrough camera access (Horizon OS v74+, Camera2 on v76+).
         BOTH permissions are required to open the passthrough cameras.
         HEADSET_CAMERA is a Horizon OS runtime permission; on non-Quest
         devices it is unknown and the request is ignored gracefully.
         ──────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />

    <!-- Microphone for video recording (runtime, optional per session). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Local-network share server + optional PC/phone transfer. Camera
         functionality never requires a network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Low-storage / recording completion notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Per Meta Passthrough Camera API documentation. -->
    <uses-feature android:name="android.hardware.camera2.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Horizon store device targeting (ignored by sideloading). -->
    <meta-data
        android:name="com.oculus.supportedDevices"
        android:value="quest3|quest3s" />

    <application
        android:name=".CameraSuiteApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.QuestCameraSuite"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
